# Dependencies. `**/` throughout: these directories now exist per workspace
# package, and a bare name only matches at the context root.
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Build outputs
**/.next
**/.vinext
**/.turbo
**/out
**/dist
**/build

# Environment files
.env*

# Testing
**/coverage

# Misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks

# Debug
*.log

# Local development
.git
.gitignore
README.md
.vscode
.idea

# Data directories - MUST exclude to prevent database lock errors
**/data/
*.db
*.db-shm
*.db-wal

# Caddy data
caddy-data/
caddy-config/

# Docker files
docker-compose.yml
docker-compose.*.yml

# Docker-based integration test rig — its own build contexts live inside it,
# and the web/caddy images never need any of it.
docker-tests
