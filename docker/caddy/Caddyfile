{
	# Bound to 0.0.0.0 within the Docker network so the web container can reach it. Port 2019 must
	# NOT be published to the host in docker-compose.yml — that is the boundary this relies on.
	#
	# `origins` rejects requests whose Origin header is not listed, which is what stops a page in the
	# operator's browser from reconfiguring the proxy. It does NOT restrict Host here: binding to an
	# open interface makes Caddy log "admin endpoint on open interface; host checking disabled" and
	# skip Host validation, so any name that resolves to this container reaches the API.
	admin 0.0.0.0:2019 {
		origins caddy:2019 localhost:2019 localhost
	}
}

# Placeholder site, HTTP only so a fresh install cannot fail a certificate order before anyone has
# configured anything. It answers until CPM applies its own configuration, which replaces this file
# wholesale — and from then on the dashboard domain is served by the managed host in
# Settings -> Dashboard Host, not by this block.
http://{$DASHBOARD_DOMAIN:caddyproxymanager.com}, http://localhost {
	respond "Caddy Proxy Manager is running - configure proxy hosts via the web interface" 200
}
