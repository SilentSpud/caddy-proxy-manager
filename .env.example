# Caddy Proxy Manager Environment Configuration
# Copy this file to .env and update with your secure values
# IMPORTANT: chmod 600 .env after creating it
#
# Most settings now live in the DATABASE, not here. A fresh install needs only
# SESSION_SECRET and POSTGRES_PASSWORD below; everything else is entered in the
# browser on first run and edited afterwards on the Settings page.
#
# Resolution order is: stored value -> this file -> built-in default. So a
# variable set here still works and still wins over the default, but is
# overridden once the same setting is saved in the app -- at which point it can
# be deleted from this file. Anything marked "Compose reads this" must stay
# regardless, because Docker cannot read the database.

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================

# PostgreSQL is the only supported backend. Compose reads these to provision the
# bundled `postgres` service, so they stay here rather than moving to Settings.
# Generate the password with: openssl rand -base64 32
#
# Any password works as typed -- base64 output contains `/` and `+`, and the app
# is handed these as discrete fields rather than folded into a URL, so there is
# nothing to escape. See DATABASE_URL further down for the exception.
POSTGRES_PASSWORD=your-postgres-password-here
#POSTGRES_USER=cpm
#POSTGRES_DB=cpm

# =============================================================================
# REQUIRED SECURITY SETTINGS (PRODUCTION)
# =============================================================================

# Session Secret (REQUIRED)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters in production.
#
# This is also the HKDF root every secret in the database is encrypted with --
# DNS provider credentials, imported private keys, agent secrets. It cannot live
# in the thing it encrypts, and rotating it makes all of them unreadable.
SESSION_SECRET=your-secure-session-secret-here-min-32-chars

# Admin Credentials -- NO LONGER REQUIRED.
#
# The first administrator is created in the browser on first run, which also
# proves the password works before any other configuration is entered. Leave
# these unset for a new install.
#
# They still work, for a deployment that predates the setup flow or automates
# its provisioning: setting BOTH seeds an admin at startup and skips the setup
# flow entirely. The password must be 12+ characters with uppercase, lowercase,
# numbers, and special characters -- the same policy the setup form enforces.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=Your-Secure-P@ssw0rd-Here!

# --- Everything below this line until the ADVANCED section is a Settings page
# --- field. Set it here to seed the value, or leave it and use the app.

# Allow public email/password account registration. Disabled by default.
AUTH_ALLOW_SELF_REGISTRATION=false

# Allow an OAuth sign-in to create a brand-new account for an unknown identity.
# Disabled by default: with OAuth enabled, existing users can still sign in (and
# link), but a first-time OAuth identity will NOT be auto-provisioned unless this
# is set to true. Enable it if OAuth is your intended onboarding path.
AUTH_ALLOW_OAUTH_REGISTRATION=false

# Trust a configured OAuth IdP to set a new user's role/status from its profile
# claims (e.g. a `role` claim). Disabled by default: role/status are forced to
# safe values (user/active) for OAuth-created accounts regardless of IdP claims.
# Only enable this if you control the IdP and intend it to manage roles.
AUTH_ALLOW_OAUTH_ROLE_FROM_CLAIMS=false

# OIDC-only mode: no local accounts at all. Disables credential sign-in, local
# account creation, password management, and the bootstrap admin seed, so
# ADMIN_USERNAME/ADMIN_PASSWORD above are not required. Enable this only once
# OAuth sign-in is confirmed working, or you will lock yourself out.
AUTH_DISABLE_LOCAL_USERS=false

# Trust the Host header when constructing URLs. Only enable this behind a proxy
# that rewrites Host, and only when BASE_URL cannot cover your setup.
AUTH_TRUST_HOST=false

# Better Auth request rate limiting (separate from the LOGIN_* login throttle
# further down). Enabled by default.
#AUTH_RATE_LIMIT_ENABLED=true
#AUTH_RATE_LIMIT_WINDOW=60
#AUTH_RATE_LIMIT_MAX=5

# Force a password reset for anyone still on a pre-argon2id bcrypt hash.
# When unset, the Settings -> Security toggle decides. Setting it here pins the
# policy and locks that toggle.
#AUTH_REQUIRE_PASSWORD_CHANGE_ON_LEGACY_HASH=true

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Public base URL for the application (IMPORTANT!)
# This is the URL where users access your Caddy Proxy Manager interface.
#
# ** REQUIRED FOR OAUTH: If using OAuth2/OIDC authentication, this MUST match
#    the redirect URI configured in your OAuth provider exactly.
#    The redirect URI is {BASE_URL}/api/auth/callback/{provider-id}, and the
#    exact value is shown in Settings -> OAuth Providers once the provider is
#    synced. Do not guess it.
#
# On first run this is filled in from the address you reached the setup page at,
# so it usually needs no value here at all.
#
# Examples:
#   - Local development: http://localhost:3000
#   - Production with domain: https://caddy-manager.example.com
#   - Production with IP: http://192.168.1.100:3000
#
# IMPORTANT: Do not include a trailing slash
BASE_URL=http://localhost:3000

# Display name in the sidebar, on the login card, and as the suffix on every
# page title. Defaults to "Caddy Proxy Manager".
#APP_NAME=Caddy Proxy Manager

# Let user icons fall back to Gravatar, which the browser fetches directly from
# gravatar.com. Set false to keep every avatar lookup off the network and lock
# the Settings -> User Avatars toggle. When unset, that toggle decides.
#AVATAR_GRAVATAR=true

# Suffix for the geoipupdate container name (geoipupdate-<HOSTNAME>), so several
# hosts sharing a Docker daemon do not collide on it. Read by Compose on the
# host, not by the app.
#
# Whether the shell exports HOSTNAME varies: Git Bash does, bash on Linux
# defines it without exporting, so Compose sees nothing and the container ends
# up named "geoipupdate-". Set it here to pin the name regardless of shell.
# Only relevant with the geoipupdate profile active.
#HOSTNAME=my-host

# =============================================================================
# ROOTLESS OPERATION (OPTIONAL)
# =============================================================================

# User and Group IDs for running containers as non-root
# Set these to match your host user to avoid permission issues with volumes
# Find your UID/GID with: id -u / id -g
#
# Defaults:
#   - Web service: PUID=10001, PGID=10001
#   - Caddy service: PUID=10000, PGID=10000
#
# For matching your host user (recommended for development):
#PUID=1000
#PGID=1000

# Caddy's GID, added to the web container's supplementary groups so it can write
# the shared /logs volume. Must match Caddy's PGID above.
#CADDY_GID=10000

# Domain the bundled Caddyfile serves the dashboard on, alongside
# http://localhost. Compose reads this and passes it to the caddy container.
#PRIMARY_DOMAIN=caddyproxymanager.com

# =============================================================================
# OAUTH2/OIDC AUTHENTICATION (OPTIONAL)
# =============================================================================

# OAuth2/OIDC Provider (works with Authentik, Authelia, Keycloak, etc.)
# Enable OAuth2 authentication with any OIDC-compliant provider.
#
# Unlike the settings above, these are not Settings page fields: they are synced
# into the oauth_providers table at startup, so a provider has one source of
# truth. Providers added in the UI live only in that table. Either way works;
# the UI is easier, because it shows you the exact callback URL to register.
# All of these can be entered on the setup page instead, under "Identity provider" -- and are
# filled in from here when they are set, so saving that step moves them into the database and the
# variables below can then be deleted. They are also editable afterwards under Settings -> OAuth
# Providers, which is the only place to add a second provider.
OAUTH_ENABLED=false
# Display name (e.g., "Authentik", "Keycloak")
OAUTH_PROVIDER_NAME=OAuth2
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# OIDC discovery URL (e.g., https://auth.example.com/application/o/app/)
OAUTH_ISSUER=

# Optional: Override auto-discovered URLs (only if OIDC discovery doesn't work)
#OAUTH_AUTHORIZATION_URL=
#OAUTH_TOKEN_URL=
#OAUTH_USERINFO_URL=

# OAuth Settings
# Auto-link OAuth to accounts without passwords
OAUTH_ALLOW_AUTO_LINKING=false

# Scopes requested from the provider. Defaults to "openid email profile"; group
# claims usually need an extra scope (e.g. "openid email profile groups").
#OAUTH_SCOPES=openid email profile

# --- Group-based roles -------------------------------------------------------
# Assign CPM roles from the provider's group claim. Either name each role's
# groups explicitly (comma-separated, any one grants the role) or set a prefix
# and let <prefix>Admin / <prefix>User / <prefix>Viewer be derived from it.
# Explicit group names take precedence over the prefix.
#OAUTH_ROLE_MAPPING=false
# Dots address nested claims: resource_access.cpm.roles
#OAUTH_GROUPS_CLAIM=groups
#OAUTH_GROUP_PREFIX=CPM_
#OAUTH_ADMIN_GROUP=
#OAUTH_USER_GROUP=
#OAUTH_VIEWER_GROUP=
# Role assigned when no role group matches
#OAUTH_DEFAULT_ROLE=user
# Mirror the remaining prefixed IdP groups into CPM groups
#OAUTH_SYNC_GROUPS=false

# Example for Authentik:
#OAUTH_ENABLED=true
#OAUTH_PROVIDER_NAME=Authentik
#OAUTH_CLIENT_ID=your-client-id
#OAUTH_CLIENT_SECRET=your-client-secret
#OAUTH_ISSUER=https://auth.example.com/application/o/caddy-proxy/
#
# IMPORTANT: Configure the redirect URI in your OAuth provider:
#   Redirect URI = {BASE_URL}/api/auth/callback/{provider-id}
#   The provider id is derived from OAUTH_PROVIDER_NAME and is not guessable by
#   hand -- read the exact URL from Settings -> OAuth Providers after startup.
#   Example: https://caddy-manager.example.com/api/auth/callback/authentik-QXV0aG

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================

# The database is configured from the POSTGRES_* variables above, which the app reads as discrete
# fields. That is deliberate: a password only has to be encoded when it goes into a URL, and a `/`
# or `@` in one silently reparses into a different host. As fields, any password works as typed.
#
# Point at a server other than the bundled `postgres` service with these:
#POSTGRES_HOST=postgres
#POSTGRES_PORT=5432
#POSTGRES_SSL=false

# Overrides all of the above when set. Only needed for something a URL can express and the fields
# cannot -- an sslmode beyond on/off, a search_path, a libpq connection option. A password in here
# must be percent-encoded (`/` is %2F, `@` is %40).
#DATABASE_URL=postgres://user:password@host:5432/database

# Connections the database pool may open. Requests beyond this queue, so raise it for a busy
# instance -- and keep the server's own max_connections above the total across all instances.
#DATABASE_POOL_MAX=10

# Caddy Admin API endpoint (usually no need to change)
#CADDY_API_URL=http://caddy:2019

# Certificate storage directory (usually no need to change)
#CERTS_DIRECTORY=./data/certs

# Login rate limiting (optional, for custom rate limit settings)
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_WINDOW_MS=300000
#LOGIN_BLOCK_MS=900000

# How long the agent waits for a Caddy image rebuild before giving up, in
# seconds. Rebuilds happen when you change the module selection in
# Settings -> Caddy Build; xcaddy compiles Caddy from source, so a few minutes
# is normal and slow or ARM hosts can take considerably longer.
#CADDY_BUILD_TIMEOUT=1800

# Dial address Caddy uses to reach this app internally for forward_auth.
# Derived from the container network by default; override only if Caddy cannot
# reach the web service at the derived address.
#FORWARD_AUTH_INTERNAL_URL=

# Cutoff after which secrets still encrypted with the legacy key are refused,
# forcing re-encryption. ISO 8601 date, or "never" to disable the cutoff.
#LEGACY_KEY_CUTOFF_DATE=never

# Container paths, only relevant to non-Docker deployments where these
# directories do not exist.
#ACME_CA_ROOT_DIR=/acme-ca
#L4_PORTS_DIR=/app/data

# Pin which pre-3.0 SQLite database the migration flow offers, instead of
# scanning the usual locations for one. Only read while setup is unfinished.
#LEGACY_SQLITE_PATH=/legacy/caddy-proxy-manager.db

# How the agent listens. `standalone` binds a Unix socket on the shared volume, which is how the
# controller in this same stack reaches it — nothing else to configure. `managed` listens on
# AGENT_PORT and prints a one-time pairing code to its logs, for an agent on another host.
#AGENT_MODE=standalone
#AGENT_PORT=3100

# Point the controller at an agent other than the local one, without using the pairing screen.
# Both are required together. An agent paired under Settings -> Agent takes precedence over these.
#AGENT_URL=http://agent.example.com:3100
#AGENT_SECRET=

# Listen address and health-check target for the cpm-server binary. Only used
# when running the compiled executable directly instead of the container.
#
# HOST defaults to "::", a dual-stack socket that accepts IPv4 as well. Set
# 0.0.0.0 to bind IPv4 only.
#PORT=3000
#HOST=::
#CPM_APP_ROOT=
#CPM_HEALTHCHECK_URL=http://127.0.0.1:3000/api/health

# =============================================================================
# UPDATE CHECKING
# =============================================================================

# Whether to ask the registry, a few times a day, if a newer release has been
# published. The only request this app makes to the internet on its own.
# Also a Settings field; a value saved there wins over this.
#UPDATE_CHECK_ENABLED=true

# The image namespace this deployment pulls from, without the image name. Change
# it if you run a fork, or the check reports releases you cannot pull.
#UPDATE_IMAGE_REPOSITORY=ghcr.io/silentspud/caddy-proxy-manager

# =============================================================================
# DOCKER COMPOSE PROFILES
# =============================================================================

# Comma-separated list of profiles to activate.
# Available profiles:
#   clickhouse   — ClickHouse analytics database (traffic + WAF events, 30-day TTL)
#   geoipupdate  — Automatic MaxMind GeoLite2 database updates (required for geo blocking)
#
# Only needed when you have no agent. With one running — which the bundled
# compose file does — Settings → Analytics and Settings → GeoIP start and stop
# these containers for you, profile or not, and this can be left empty.
#
# Pick one owner per service. Once a credential lives in Settings, remove the
# profile here and the variable below: leaving both means your own
# `docker compose up -d` also creates the container, from the now-stale copy.
# To combine profiles: COMPOSE_PROFILES=clickhouse,geoipupdate
COMPOSE_PROFILES=clickhouse

# =============================================================================
# CLICKHOUSE ANALYTICS
# =============================================================================

# Everything below is a Settings → Analytics field. A value saved there is
# stored in the database and wins over the variable, which can then be deleted.
# These remain for a first start, and for a deployment with no agent: the agent
# passes the saved credentials to Compose itself, so it does not need them here.
#
# Whether analytics run at all. Leave unset to decide from whether a password is
# set below, which is what earlier releases did.
#ANALYTICS_ENABLED=true

# Generate with: openssl rand -base64 32. Required — ClickHouse will not start
# without one.
#
# The controller pushes these credentials to every agent, which is how each host
# writes its own Caddy log events. Nothing to configure on the agent side.
CLICKHOUSE_PASSWORD=your-clickhouse-password-here
#CLICKHOUSE_URL=http://clickhouse:8123
#CLICKHOUSE_USER=cpm
#CLICKHOUSE_DB=analytics

# How long analytics events (traffic + WAF) are retained before ClickHouse's
# TTL deletes them. Defaults to 30 days. Lower this to use less disk space.
# Changing it migrates the existing tables' TTL on the next startup.
#CLICKHOUSE_RETENTION_DAYS=30

# =============================================================================
# GEOIP UPDATE (OPTIONAL)
# =============================================================================

# Automatic GeoLite2 database updates — needed for geo blocking.
# Get credentials at: https://www.maxmind.com/en/geolite2/signup
#
# Also a Settings → GeoIP field, and the same rule applies: a value saved there
# wins and lets the agent start geoipupdate without a Compose profile. Only the
# controller needs them — agents on other hosts fetch the databases through it,
# with no licence key of their own.
#
# Whether GeoIP is used at all. Leave unset to decide from whether the databases
# are already present, which is what earlier releases did.
#GEOIP_ENABLED=true
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
