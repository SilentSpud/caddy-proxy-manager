# Caddy Proxy Manager Environment Configuration
# Copy this file to .env and update with your secure values
# IMPORTANT: chmod 600 .env after creating it

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================

# PostgreSQL is the only supported backend. These provision the bundled `postgres`
# service and are read by Compose, which cannot read the database, so they stay here
# rather than moving into the settings UI.
# Generate the password with: openssl rand -base64 32
POSTGRES_PASSWORD=your-postgres-password-here
# POSTGRES_USER=cpm
# POSTGRES_DB=cpm

# =============================================================================
# REQUIRED SECURITY SETTINGS (PRODUCTION)
# =============================================================================

# Session Secret (REQUIRED)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters in production
SESSION_SECRET=your-secure-session-secret-here-min-32-chars

# Admin Credentials (REQUIRED)
# USERNAME: Any username (e.g., "admin" is fine)
# PASSWORD: Must be 12+ characters with:
#   - Uppercase letters (A-Z)
#   - Lowercase letters (a-z)
#   - Numbers (0-9)
#   - Special characters (!@#$%^&* etc.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Your-Secure-P@ssw0rd-Here!

# Allow public email/password account registration. Disabled by default.
AUTH_ALLOW_SELF_REGISTRATION=false

# Allow an OAuth sign-in to create a brand-new account for an unknown identity.
# Disabled by default: with OAuth enabled, existing users can still sign in (and
# link), but a first-time OAuth identity will NOT be auto-provisioned unless this
# is set to true. Enable it if OAuth is your intended onboarding path.
AUTH_ALLOW_OAUTH_REGISTRATION=false

# Trust a configured OAuth IdP to set a new user's role/status from its profile
# claims (e.g. a `role` claim). Disabled by default: role/status are forced to
# safe values (user/active) for OAuth-created accounts regardless of IdP claims.
# Only enable this if you control the IdP and intend it to manage roles.
AUTH_ALLOW_OAUTH_ROLE_FROM_CLAIMS=false

# OIDC-only mode: no local accounts at all. Disables credential sign-in, local
# account creation, password management, and the bootstrap admin seed, so
# ADMIN_USERNAME/ADMIN_PASSWORD above are not required. Enable this only once
# OAuth sign-in is confirmed working, or you will lock yourself out.
AUTH_DISABLE_LOCAL_USERS=false

# Trust the Host header when constructing URLs. Only enable this behind a proxy
# that rewrites Host, and only when BASE_URL cannot cover your setup.
AUTH_TRUST_HOST=false

# Better Auth request rate limiting (separate from the LOGIN_* login throttle
# further down). Enabled by default.
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_WINDOW=60
# AUTH_RATE_LIMIT_MAX=5

# Force a password reset for anyone still on a pre-argon2id bcrypt hash.
# When unset, the Settings -> Security toggle decides. Setting it here pins the
# policy and locks that toggle.
# AUTH_REQUIRE_PASSWORD_CHANGE_ON_LEGACY_HASH=true

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Public base URL for the application (IMPORTANT!)
# This is the URL where users access your Caddy Proxy Manager interface.
#
# ** REQUIRED FOR OAUTH: If using OAuth2/OIDC authentication, this MUST match
#    the redirect URI configured in your OAuth provider exactly.
#    The redirect URI will be: {BASE_URL}/api/auth/callback/oauth2
#
# Examples:
#   - Local development: http://localhost:3000
#   - Production with domain: https://caddy-manager.example.com
#   - Production with IP: http://192.168.1.100:3000
#
# IMPORTANT: Do not include a trailing slash
BASE_URL=http://localhost:3000

# Display name in the sidebar, on the login card, and as the suffix on every
# page title. Defaults to "Caddy Proxy Manager".
# APP_NAME=Caddy Proxy Manager

# Let user icons fall back to Gravatar, which the browser fetches directly from
# gravatar.com. Set false to keep every avatar lookup off the network and lock
# the Settings -> User Avatars toggle. When unset, that toggle decides.
# AVATAR_GRAVATAR=true

# Suffix for the geoipupdate container name (geoipupdate-<HOSTNAME>), so several
# hosts sharing a Docker daemon do not collide on it. Read by Compose on the
# host, not by the app.
#
# Whether the shell exports HOSTNAME varies: Git Bash does, bash on Linux
# defines it without exporting, so Compose sees nothing and the container ends
# up named "geoipupdate-". Set it here to pin the name regardless of shell.
# Only relevant with the geoipupdate profile active.
# HOSTNAME=my-host

# =============================================================================
# ROOTLESS OPERATION (OPTIONAL)
# =============================================================================

# User and Group IDs for running containers as non-root
# Set these to match your host user to avoid permission issues with volumes
# Find your UID/GID with: id -u / id -g
#
# Defaults:
#   - Web service: PUID=10001, PGID=10001
#   - Caddy service: PUID=10000, PGID=10000
#
# For matching your host user (recommended for development):
# PUID=1000
# PGID=1000

# =============================================================================
# OAUTH2/OIDC AUTHENTICATION (OPTIONAL)
# =============================================================================

# OAuth2/OIDC Provider (works with Authentik, Authelia, Keycloak, etc.)
# Enable OAuth2 authentication with any OIDC-compliant provider
OAUTH_ENABLED=false
OAUTH_PROVIDER_NAME=OAuth2             # Display name (e.g., "Authentik", "Keycloak")
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=                          # OIDC discovery URL (e.g., https://auth.example.com/application/o/app/)

# Optional: Override auto-discovered URLs (only if OIDC discovery doesn't work)
# OAUTH_AUTHORIZATION_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=

# OAuth Settings
OAUTH_ALLOW_AUTO_LINKING=false         # Auto-link OAuth to accounts without passwords

# Scopes requested from the provider. Defaults to "openid email profile"; group
# claims usually need an extra scope (e.g. "openid email profile groups").
# OAUTH_SCOPES=openid email profile

# --- Group-based roles -------------------------------------------------------
# Assign CPM roles from the provider's group claim. Either name each role's
# groups explicitly (comma-separated, any one grants the role) or set a prefix
# and let <prefix>Admin / <prefix>User / <prefix>Viewer be derived from it.
# Explicit group names take precedence over the prefix.
# OAUTH_ROLE_MAPPING=false
# OAUTH_GROUPS_CLAIM=groups            # Dots address nested claims: resource_access.cpm.roles
# OAUTH_GROUP_PREFIX=CPM_
# OAUTH_ADMIN_GROUP=
# OAUTH_USER_GROUP=
# OAUTH_VIEWER_GROUP=
# OAUTH_DEFAULT_ROLE=user              # Role assigned when no role group matches
# OAUTH_SYNC_GROUPS=false              # Mirror the remaining prefixed IdP groups into CPM groups

# Example for Authentik:
# OAUTH_ENABLED=true
# OAUTH_PROVIDER_NAME=Authentik
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_ISSUER=https://auth.example.com/application/o/caddy-proxy/
#
# IMPORTANT: Configure the redirect URI in your OAuth provider:
#   Redirect URI = {BASE_URL}/api/auth/callback/oauth2
#   Example: http://localhost:3000/api/auth/callback/oauth2
#   or: https://caddy-manager.example.com/api/auth/callback/oauth2

# =============================================================================
# INSTANCE SYNC (OPTIONAL)
# =============================================================================

# Run a controller that pushes configuration to one or more agents on every
# change. Synced data: proxy hosts, certificates, access lists, and settings.
# User accounts are NOT synced.
#
# Roles: standalone (default), controller, or agent. The pre-2.0 spellings
# "master"/"slave" are rejected at startup, not translated.
# INSTANCE_MODE=standalone

# Generate one token per pair with: openssl rand -hex 32
# Tokens shorter than 32 characters, longer than 512, or padded with whitespace
# are rejected. An agent will not start without one.
#
# On the agent:
# INSTANCE_MODE=agent
# INSTANCE_SYNC_TOKEN=
#
# On the controller (JSON array of the agents to push to):
# INSTANCE_MODE=controller
# INSTANCE_AGENTS=[{"name":"replica","url":"https://replica.example.com","token":"<64-hex-character-token>"}]

# Periodic re-sync interval in seconds on the controller. 0 disables it, leaving
# only the push that happens on every change.
# INSTANCE_SYNC_INTERVAL=0

# Allow sync over plain HTTP. Only for a trusted internal Docker network.
# INSTANCE_SYNC_ALLOW_HTTP=false

# Agent-side limits on inbound sync requests.
# INSTANCE_SYNC_MAX_BYTES=
# INSTANCE_SYNC_RATE_MAX=60
# INSTANCE_SYNC_RATE_WINDOW_MS=60000

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================

# Override only to point at a PostgreSQL server other than the bundled `postgres`
# service. Built from POSTGRES_* below when unset.
# DATABASE_URL=postgres://user:password@host:5432/database

# Connections the database pool may open. Requests beyond this queue, so raise it for a busy
# instance -- and keep the server's own max_connections above the total across all instances.
# DATABASE_POOL_MAX=10

# Caddy Admin API endpoint (usually no need to change)
# CADDY_API_URL=http://caddy:2019

# Certificate storage directory (usually no need to change)
# CERTS_DIRECTORY=./data/certs

# Login rate limiting (optional, for custom rate limit settings)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MS=300000
# LOGIN_BLOCK_MS=900000

# How long the agent waits for a Caddy image rebuild before giving up, in
# seconds. Rebuilds happen when you change the module selection in
# Settings -> Caddy Build; xcaddy compiles Caddy from source, so a few minutes
# is normal and slow or ARM hosts can take considerably longer.
# CADDY_BUILD_TIMEOUT=1800

# Dial address Caddy uses to reach this app internally for forward_auth.
# Derived from the container network by default; override only if Caddy cannot
# reach the web service at the derived address.
# FORWARD_AUTH_INTERNAL_URL=

# Cutoff after which secrets still encrypted with the legacy key are refused,
# forcing re-encryption. ISO 8601 date, or "never" to disable the cutoff.
# LEGACY_KEY_CUTOFF_DATE=never

# Container paths, only relevant to non-Docker deployments where these
# directories do not exist.
# ACME_CA_ROOT_DIR=/acme-ca
# L4_PORTS_DIR=/app/data

# Listen address and health-check target for the cpm-server binary. Only used
# when running the compiled executable directly instead of the container.
# PORT=3000
# HOST=0.0.0.0
# CPM_APP_ROOT=
# CPM_HEALTHCHECK_URL=http://127.0.0.1:3000/api/health

# =============================================================================
# DOCKER COMPOSE PROFILES
# =============================================================================

# Comma-separated list of profiles to activate.
# Available profiles:
#   clickhouse   — ClickHouse analytics database (traffic + WAF events, 30-day TTL)
#   geoipupdate  — Automatic MaxMind GeoLite2 database updates (required for geo blocking)
#
# To disable analytics, remove "clickhouse" from this list (or leave it empty).
# To combine profiles: COMPOSE_PROFILES=clickhouse,geoipupdate
COMPOSE_PROFILES=clickhouse

# =============================================================================
# CLICKHOUSE ANALYTICS
# =============================================================================

# Required when the clickhouse profile is active.
# Generate with: openssl rand -base64 32
CLICKHOUSE_PASSWORD=your-clickhouse-password-here
# CLICKHOUSE_URL=http://clickhouse:8123
# CLICKHOUSE_USER=cpm
# CLICKHOUSE_DB=analytics

# How long analytics events (traffic + WAF) are retained before ClickHouse's
# TTL deletes them. Defaults to 30 days. Lower this to use less disk space.
# Changing it migrates the existing tables' TTL on the next startup.
# CLICKHOUSE_RETENTION_DAYS=30

# =============================================================================
# GEOIP UPDATE (OPTIONAL)
# =============================================================================

# Automatic GeoLite2 database updates — needed for geo blocking.
# Add "geoipupdate" to COMPOSE_PROFILES above, then fill in credentials.
# Get credentials at: https://www.maxmind.com/en/geolite2/signup
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
