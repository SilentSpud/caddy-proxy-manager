{
  "name": "caddy-proxy-manager",
  "version": "2.0.0-beta.1",
  "description": "Web UI for managing Caddy reverse proxies",
  "contributors": [
    "fuomag9 <1580624+fuomag9@users.noreply.github.com>",
    "SilentSpud <1478389+SilentSpud@users.noreply.github.com>"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "astryx": {
    "theme": "neutral"
  },
  "private": true,
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && bun scripts/inject-runtime-guard.mjs",
    "build:binary": "bun build --compile --target=${BUN_COMPILE_TARGET:-bun} --outfile dist/standalone/cpm-server scripts/standalone-entry.ts",
    "start": "vinext start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "tsc --noEmit",
    "test:all": "./scripts/test-all.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "bun --bun vitest run --config tests/vitest.config.ts",
    "test:watch": "bun --bun vitest --config tests/vitest.config.ts",
    "test:ui": "bun --bun vitest --ui --config tests/vitest.config.ts",
    "test:coverage": "bun --bun vitest run --coverage --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config tests/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed --config tests/playwright.config.ts",
    "test:e2e:no-clickhouse": "playwright test --config tests/playwright.no-clickhouse.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.5.0",
    "@astryxdesign/theme-neutral": "^0.5.0",
    "@clickhouse/client": "^1.23.1",
    "apexcharts": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.2",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "^6.6.0",
    "maxmind": "^5.0.7",
    "monaco-editor": "^0.56.0",
    "next": "^16.3.3",
    "node-forge": "^1.4.0",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "react-server-dom-webpack": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
