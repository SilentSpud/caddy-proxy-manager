{
  "name": "caddy-proxy-manager",
  "version": "1.0.0",
  "description": "Caddy Proxy Manager - web UI for managing Caddy reverse proxies with OAuth2 authentication.",
  "astryx": {
    "theme": "neutral"
  },
  "private": true,
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "tsc --noEmit",
    "test:all": "./scripts/test-all.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:ui": "vitest --ui --config tests/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config tests/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed --config tests/playwright.config.ts",
    "test:e2e:no-clickhouse": "playwright test --config tests/playwright.no-clickhouse.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.6",
    "@astryxdesign/theme-neutral": "^0.4.6",
    "@clickhouse/client": "^1.23.1",
    "@tailwindcss/postcss": "^4.3.3",
    "apexcharts": "^6.10.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.5.0",
    "maxmind": "^5.0.7",
    "monaco-editor": "^0.55.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.2.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.19.0",
    "typescript": "^7.0.2",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2"
  },
  "type": "module"
}
