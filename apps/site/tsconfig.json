{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // The demos render the controller's own components, whose imports are written against its
    // tsconfig paths. These mirror the Vite aliases in astro.config.mjs - see the note there for
    // why `next-intl` and `next/navigation` resolve to shims rather than to Next itself.
    "paths": {
      "@/components/*": ["../controller/src/components/*"],
      "@/lib/*": ["../controller/src/lib/*"],
      "@/src/*": ["../controller/src/*"],
      "next-intl": ["./src/demos/shims/next-intl.ts"],
      "next/navigation": ["./src/demos/shims/next-navigation.ts"]
    }
  },
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro", "**/*.mjs"],
  "exclude": ["dist"]
}
