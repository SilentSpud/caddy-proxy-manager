{
  "name": "@cpm/controller",
  "version": "3.0.0-rc.1",
  "description": "Caddy Proxy Manager controller — the web UI and REST API",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && bun scripts/inject-runtime-guard.mjs",
    "build:binary": "bun build --compile --target=${BUN_COMPILE_TARGET:-bun} --outfile dist/standalone/cpm-server scripts/standalone-entry.ts",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "bun scripts/with-test-db.ts bun test --parallel tests/unit tests/integration",
    "test:watch": "bun scripts/with-test-db.ts bun test --watch tests/unit tests/integration",
    "test:coverage": "bun scripts/with-test-db.ts bun test --isolate --coverage tests/unit tests/integration && bun scripts/coverage-ratchet.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config tests/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed --config tests/playwright.config.ts",
    "test:e2e:no-clickhouse": "playwright test --config tests/playwright.no-clickhouse.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.5.3",
    "@astryxdesign/theme-neutral": "^0.5.3",
    "@clickhouse/client": "^1.23.1",
    "@cpm/shared": "workspace:*",
    "apexcharts": "^7.1.0",
    "better-auth": "^1.7.3",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "maplibre-gl": "^6.7.0",
    "maxmind": "^5.0.7",
    "monaco-editor": "^0.56.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "node-forge": "^1.4.0",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.3",
    "react-server-dom-webpack": "^19.2.8",
    "sonner": "^2.0.8",
    "swagger-ui-react": "5.32.15",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@better-auth/core": "^1.7.3",
    "@eloqnt/cli": "^0.6.29",
    "@maplibre/maplibre-gl-style-spec": "^26.4.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/swagger-ui-react": "5.18.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.10",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2"
  }
}
